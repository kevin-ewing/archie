{
  "name": "archie",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "preview": "vite preview",
    "check": "tsc && node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "perf": "npm run benchmark",
    "benchmark": "node --experimental-strip-types src/perf.ts",
    "benchmark:check": "node --experimental-strip-types src/perf.ts --check",
    "benchmark:record": "node --experimental-strip-types src/perf.ts --record",
    "benchmark:update": "node --experimental-strip-types src/perf.ts --update",
    "verify": "npm run check && npm run benchmark:check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "tone": "^15.1.22"
  }
}
